# Copy to .env.local (gitignored) and fill in for local dev. Never commit real values.

EXPO_PUBLIC_API_URL=http://localhost:8000

# Google Cloud Console -> OAuth client ID (Web application). Public client id, no secret needed —
# the Circle screen's Gmail connect uses Google Identity Services' browser token flow directly,
# gmail.metadata scope only. Same credential as the root .env's GOOGLE_OAUTH_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Onboarding no longer uses Supabase auth (see src/state/local-identity.ts) — sign-in is a local,
# unverified name+email pair kept in the browser. Set this to a real, pre-obtained Supabase JWT
# for one shared demo account to unlock the real API for everyone instead (answers save server-side,
# GET /me confirms Persona verification). Without it, answers save to localStorage only and Persona's
# flow is still fully testable, just unconfirmable from inside the app.
EXPO_PUBLIC_DEMO_TOKEN=

# Persona hosted-flow inquiry template id (docs/log/D.md). Defaults to the project's real template
# (itmpl_AH43ZFeBwqDRXTQLsUW8vEpdokrjAU) if unset — only override if Lane D rotates it.
EXPO_PUBLIC_PERSONA_TEMPLATE_ID=
