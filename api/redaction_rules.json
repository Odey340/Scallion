{
  "version": 1,
  "purpose": "Client-side redaction of a lab report before upload (CLAUDE.md rule 2). Lane C applies these to the text layer in the browser; lane D keeps them and tests them against fixtures.",
  "regex_dialect": "ECMAScript, case-insensitive (new RegExp(pattern, 'i') in JS; re.compile(pattern, re.I) in Python). No inline flags, no lookbehind, no named groups.",
  "how_to_apply": [
    "Split the text layer into lines (pdf.js: text items grouped by y coordinate, joined by a space; pypdf: split on newline).",
    "For each line, test every rule in order. The first drop_line match wins; mask rules are applied to whatever survives.",
    "action=drop_line: black out the bounding boxes of every text item on that line and remove the line from any text you upload.",
    "action=mask: black out and replace only the matched substring (same regex with the global flag); the rest of the line stays.",
    "Never drop a line that matches keep_if (an analyte result row); a mask rule may still redact a substring of it.",
    "Upload only the redacted document; never the original."
  ],
  "mask_token": "[REDACTED]",
  "keep_if": {
    "pattern": "^\\s*[A-Za-z][A-Za-z0-9 ,./()*%#-]{0,60}?\\s+[<>]?\\d+(\\.\\d+)?\\s*(%|g/dL|g/L|mg/dL|mg/L|mmol/L|umol/L|\u00b5mol/L|fL|pg|U/L|IU/L|10\\*?\\^?[369]/[u\u00b5]L|K/[u\u00b5]L|x?10\\^?[369]/L|mL/min)",
    "note": "A result row: name, number, unit. Guards against a clinician or address pattern that happens to match an analyte line."
  },
  "rules": [
    {"id": "patient_name_label", "category": "name", "action": "drop_line",
     "pattern": "^\\s*(patient|pt\\.?|name|patient\\s*name|nombre|paciente|apellidos?|full\\s*name|last\\s*name|first\\s*name|surname)\\s*(name|id|no\\.?|#)?\\s*[:#]",
     "note": "Patient: JOHN DOE / Name: DOE, JOHN / Nombre: ..."},
    {"id": "name_lastfirst_inline", "category": "name", "action": "drop_line",
     "pattern": "\\b(patient|name|nombre|paciente)\\s*[:#]\\s*[A-Za-z\u00c0-\u00ff'.-]+\\s*,\\s*[A-Za-z\u00c0-\u00ff'.-]+",
     "note": "DOE, JOHN anywhere on the line after a patient/name label"},
    {"id": "dob_label", "category": "dob", "action": "drop_line",
     "pattern": "\\b(dob|d\\.o\\.b\\.?|date\\s*of\\s*birth|birth\\s*date|birthdate|born|fecha\\s*de\\s*nacimiento|fecha\\s*nac\\.?|f\\.?\\s*nac\\.?)\\b",
     "note": "DOB: 01/02/1980, Date of Birth 1980-01-02, Fecha de nacimiento: ..."},
    {"id": "mrn_label", "category": "mrn", "action": "drop_line",
     "pattern": "\\b(mrn|mr\\s*no\\.?|mr\\s*#|medical\\s*record\\s*(no\\.?|number|#)?|patient\\s*(id|no\\.?|number|#)|chart\\s*(no\\.?|#|number)|account\\s*(no\\.?|#|number)|acct\\s*#?|expediente|historia\\s*cl[i\u00ed]nica|n[u\u00fa]mero\\s*de\\s*paciente|no\\.?\\s*de\\s*paciente)\\s*[:#]?",
     "note": "MRN, medical record, patient ID, account number, expediente"},
    {"id": "ssn_or_national_id", "category": "mrn", "action": "mask",
     "pattern": "\\b(\\d{3}-\\d{2}-\\d{4}|ssn\\s*[:#]?\\s*[\\dXx*-]{9,11}|curp\\s*[:#]?\\s*[A-Z0-9]{18}|dni\\s*[:#]?\\s*\\d{7,9}[A-Z]?)\\b",
     "note": "US SSN, Mexican CURP, Spanish DNI"},
    {"id": "address_label", "category": "address", "action": "drop_line",
     "pattern": "^\\s*(address|addr\\.?|street|home\\s*address|mailing\\s*address|direcci[o\u00f3]n|domicilio|calle|residence)\\s*[:#]",
     "note": "Address: 123 Main St"},
    {"id": "street_address", "category": "address", "action": "drop_line",
     "pattern": "\\b\\d{1,6}\\s+[A-Za-z0-9.'-]+(\\s+[A-Za-z0-9.'-]+){0,4}\\s+(st|street|ave|avenue|blvd|boulevard|rd|road|dr|drive|ln|lane|ct|court|way|pl|place|pkwy|parkway|hwy|highway|cir|circle|ter|terrace|trl|trail|apt|unit|suite|ste)\\b\\.?(\\s|,|$)",
     "note": "123 Main St / 4500 Old Spanish Trl Apt 2. Guarded by keep_if for rows like 'Vitamin D 25 ng/mL'."},
    {"id": "city_state_zip", "category": "address", "action": "drop_line",
     "pattern": "\\b[A-Za-z .'-]{2,40},?\\s+[A-Z]{2}\\s+\\d{5}(-\\d{4})?\\b",
     "note": "Houston, TX 77005"},
    {"id": "po_box", "category": "address", "action": "drop_line",
     "pattern": "\\bp\\.?\\s*o\\.?\\s*box\\s*\\d+",
     "note": "PO Box 123"},
    {"id": "ordering_physician_label", "category": "physician", "action": "drop_line",
     "pattern": "\\b(ordering|referring|requesting|attending|treating|primary|responsible|reporting|authorizing|collecting|reviewing)\\s*(physician|provider|clinician|practitioner|doctor|md|do|np|pa)\\b",
     "note": "Ordering Physician: ..., Referring Provider: ..."},
    {"id": "physician_label", "category": "physician", "action": "drop_line",
     "pattern": "^\\s*(physician|provider|clinician|doctor|md|dr\\.?|requested\\s*by|ordered\\s*by|signed\\s*by|reviewed\\s*by|m[e\u00e9]dico|doctora?|solicitado\\s*por|solicitante|firma)\\s*[:#]",
     "note": "Physician: ... / M\u00e9dico: ..."},
    {"id": "doctor_name_inline", "category": "physician", "action": "drop_line",
     "pattern": "\\b(dr|dra)\\.?\\s+[A-Za-z][A-Za-z\u00c0-\u00ff'.-]*(\\s+[A-Za-z][A-Za-z\u00c0-\u00ff'.-]*)*|,\\s*(m\\.?d\\.?|d\\.?o\\.?|np|pa-c)\\b",
     "note": "Dr. A. Smith / SMITH, JOHN, MD"},
    {"id": "npi_or_license", "category": "physician", "action": "mask",
     "pattern": "\\b(npi|upin|dea|license\\s*(no\\.?|#)?|lic\\.?\\s*#?)\\s*[:#]?\\s*[A-Z0-9-]{5,15}\\b",
     "note": "NPI 1234567890"},
    {"id": "phone_fax", "category": "contact", "action": "mask",
     "pattern": "\\b(tel|tele?phone|phone|fax|mobile|cell|celular|tel[e\u00e9]fono|ph)\\.?\\s*[:#]?\\s*\\(?\\+?\\d[\\d\\s().-]{7,15}\\d\\b|\\(\\d{3}\\)\\s*\\d{3}[\\s.-]\\d{4}\\b|\\b\\d{3}[.-]\\d{3}[.-]\\d{4}\\b",
     "note": "Phone: (713) 555-0100 / 713-555-0100"},
    {"id": "email", "category": "contact", "action": "mask",
     "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
     "note": "any email address"},
    {"id": "accession_or_specimen_id", "category": "mrn", "action": "mask",
     "pattern": "\\b(accession|specimen|requisition|req\\.?|order|lab)\\s*(no\\.?|number|id|#)\\s*[:#]?\\s*[A-Z0-9-]{5,20}\\b",
     "note": "Accession #: AB123456. Masks only the identifier so 'Specimen: Serum' survives."},
    {"id": "insurance", "category": "mrn", "action": "drop_line",
     "pattern": "\\b(insurance|insurer|policy\\s*(no\\.?|number|#)|member\\s*(id|no\\.?|#)|group\\s*(no\\.?|number|#)|medicare|medicaid|aseguradora|p[o\u00f3]liza)\\b",
     "note": "Insurance / Member ID lines"}
  ],
  "kept_on_purpose": [
    "Sex and Age lines (the clock needs them and they do not identify a person on their own; C reads them from the user profile anyway).",
    "Collected / Reported dates (used for the re-test date). Dates count as PHI only alongside an identifier, which these rules remove.",
    "Laboratory name in the letterhead may survive if it has no street number; that identifies the lab, not the patient."
  ]
}
